<section class="section-pad" id="capabilities">
  <div class="wrap">
    <div class="reveal" style="max-width:660px">
      <span class="kicker">One product, four vantage points</span>
      <h2 class="title">Everyone sees <span class="h-mark">their own school<svg class="scribble-circle" viewBox="0 0 320 90" preserveAspectRatio="none" aria-hidden="true"><path style="--len:760" d="M40 12 C 130 2, 250 4, 300 26 C 316 42, 268 76, 160 82 C 66 87, 6 72, 8 48 C 10 28, 44 16, 96 10"/></svg></span></h2>
      <p class="section-sub">
        Same school, four different jobs — each one gets exactly the slice that belongs to them.
      </p>
    </div>

    <!-- folder: a row of role tabs over one shared panel (Amplemarket mechanic) -->
    <div class="rolefolder reveal">
      <div class="rf-tabs" role="tablist" aria-label="Roles">
        <button class="rf-tab active" type="button" data-role="teachers" role="tab" aria-selected="true">
          <span class="rf-art"><img loading="lazy" src="/assets/img/stickers/char-05.png" alt="" width="86" height="86"></span>
          <b>Teachers</b>
        </button>
        <button class="rf-tab" type="button" data-role="admins" role="tab" aria-selected="false">
          <span class="rf-art"><img loading="lazy" src="/assets/img/stickers/char-03.png" alt="" width="86" height="86"></span>
          <b>Admins</b>
        </button>
        <button class="rf-tab" type="button" data-role="students" role="tab" aria-selected="false">
          <span class="rf-art"><img loading="lazy" src="/assets/img/stickers/char-10.png" alt="" width="86" height="86"></span>
          <b>Students</b>
        </button>
        <button class="rf-tab" type="button" data-role="parents" role="tab" aria-selected="false">
          <span class="rf-art"><img loading="lazy" src="/assets/img/stickers/char-22.png" alt="" width="86" height="86"></span>
          <b>Parents</b>
        </button>
      </div>
      <div class="rf-panel"><!-- rendered by main.js --></div>
    </div>
  </div>
</section>
