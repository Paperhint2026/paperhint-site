---
/* The essentials: five for a teacher, five for a school.
 *
 * Curated, not complete — what is scattered today and needed now. Laid out in
 * the site's OWN folder-card language (.fcard, its folder-tab kicker, its
 * tint dot, its tilt and warm glint on reveal), so the page reads as
 * Paperhint rather than as a generic grid of rounded boxes. The 6-column
 * bento is the same one section 2 of the home page uses.
 *
 * Each card argues by contrast: what it replaces today, then what it does.
 *
 * Content is ESSENTIALS in src/data/product.js. Nothing is authored here.
 */
import { ESSENTIALS } from '../data/product.js';

/* `only` renders one set (a role page); omitted renders both (the product). */
const { only } = Astro.props;
const sets = only ? ESSENTIALS.filter(s => s.who === only) : ESSENTIALS;
---
{sets.map(set => (
  <section class="ess" id={`for-${set.who}`}>
    <div class="wrap wrap-read">
      <h2 class="sec-h2 reveal">{set.title}</h2>
      <p class="ess-lead reveal">{set.lead}</p>
      <div class="feature-grid ess-grid">
        {set.items.map(it => (
          <article class="fcard ess-card reveal" style={`--tint:var(--${it.tint || 'emerald'})`}>
            <span class="fcard-kicker" set:html={it.tag} />
            <h3>
              {it.label}
              {it.badge && <span class="beat-badge">{it.badge}</span>}
            </h3>
            <div class="ess-body">
              <p class="ess-today">{it.today}</p>
              <p set:html={it.text} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
))}
