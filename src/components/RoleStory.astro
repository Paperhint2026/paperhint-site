---
/* One role, one page, three moves.
 *
 * Banner, then a grand intro that says what this person's problem actually is
 * and what Paperhint is inside it, then the product — only the part of it
 * this person touches. Nothing after that but the ask.
 *
 * This replaced a nine-section page whose middle was a Monday-to-Friday
 * diary. The weekday framing still lives in api/chat-content.js, where it
 * belongs: it reads as an answer in conversation, not as a page.
 *
 * Content comes from src/data/roles.js and src/data/product.js. Nothing is
 * authored here.
 */
import Tiles from '../components/Tiles.astro';
import ChipDrift from '../components/ChipDrift.astro';
import { ROLES } from '../data/roles.js';
import { featuresFor, tabFor, ESSENTIALS } from '../data/product.js';

const { role } = Astro.props;
const r = ROLES[role];

/* A page still waiting on its narrative says "More on this soon" in public;
   on preview and locally it also lists exactly what it is waiting for, so the
   gaps are visible while working. A visiting school never sees a draft note. */
const internal = process.env.VERCEL_ENV !== 'production';

/* Teachers and schools have a curated five — what is scattered today and
   needed now. Students and parents touch too little of the product to rank,
   so they keep the filtered list of what actually reaches them. */
const curated = ESSENTIALS.some(e => e.who === role);

/* The product through this person's eyes: only the features the feature list
   says reach them, in the order the product page tells them. */
/* Deliberately NOT grouped by where the work happens. Those groups are the
   product page's shelves — "In the school office" is a strange heading on a
   parent's page. Here it is one run of features under this person's own
   heading, in the order the product page tells them. */
const mine = featuresFor(role);

/* Anything the role data marks as still being built is held back from the
   feature rows and stated once, plainly, at the end. Never promise what has
   not shipped. */
const NEXT = /^Being built next:\s*/i;
const next = (r.keeps || []).filter(k => NEXT.test(k)).map(k => k.replace(NEXT, ''));
---
<header class="role-hero">
  <div class="wrap wrap-read">
    <span class="tagline"><span class="tag">{r.kicker}</span> Paperhint <i>·</i></span>
    <h1 class="display role-h1">{r.h1[0]}<em>{r.h1[1]}</em>{r.h1[2]}</h1>
    <p class="role-sub">{r.sub}</p>
    {r.thin && <p class="role-soon">More on this soon</p>}
    {internal && r.needs && (
      <div class="role-needs">
        <b>Waiting on content</b>
        <ul>{r.needs.map(n => <li>{n}</li>)}</ul>
      </div>
    )}
    <div class="role-cta">
      <a class="btn btn-primary btn-lg" href={`/contact?type=demo&role=${role}`}>Book a demo</a>
      <a class="btn btn-ghost btn-lg" href="/product">See the whole product</a>
    </div>
  </div>
</header>

<!-- the grand intro: the problem, then the line that flips it -->
<section class="role-intro">
  <div class="wrap wrap-read">
    <p class="intro-statement reveal" set:html={(r.intro && r.intro.statement) || r.scene} />
    {r.intro && r.intro.turn && <p class="intro-turn reveal">{r.intro.turn}</p>}
    <p class="intro-answer reveal" set:html={(r.intro && r.intro.answer) || r.turn} />
  </div>
</section>

<!-- the scatter, shown as a drifting field rather than asserted -->
<ChipDrift who={role} />

<!-- the features, image-led: the panel is the tile, the words sit under it -->
{curated
  ? <Tiles only={role} />
  : mine.length > 0 && (
      <section class="tiles-sec" id="features">
        <div class="wrap wrap-read">
          <div class="sechead reveal"><h2 class="sechead-h">{r.stopsTitle}</h2></div>
          <div class="tiles">
            {mine.map((f, i) => (
              <article class={`tile reveal ${i === 0 ? 'tile-wide' : ''}`}
                       style={`--tint:var(--${['emerald','violet','orange','yellow'][i % 4]})`}>
                <div class="tile-panel">
                  <div class="v-rows">
                    <span><b>&#10003;</b>{tabFor(f)}<i>live</i></span>
                    <span class="sum"><b>&#8721;</b>Recorded to the student<i>&#10003;</i></span>
                  </div>
                </div>
                <div class="tile-cap">
                  <h3>{f.label}{f.badge && <span class="beat-badge">{f.badge}</span>}</h3>
                  <p set:html={f.text} />
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

<!-- the close: the site's own CTA band, in this role's words -->
<section class="cta role-cta-band">
  <div class="wrap wrap-read">
    <div data-component="cta-banner" data-heading={r.cta.heading} data-sub={r.cta.sub}></div>
  </div>
</section>
