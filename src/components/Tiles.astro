---
/* IMAGE-LED TILES — Mercury's feature grid.
 *
 * The important difference from a card: there is no card. The tile IS a large
 * visual panel, and the label and sentence sit UNDERNEATH it, on the page,
 * with no border and no fill. Weighting the visual first is what stops a
 * features section reading as a table of text boxes.
 *
 * The panels alternate dark and light ground tile by tile — the contrast
 * shift the founder asked for, at tile scale rather than section scale.
 *
 * Until real product screens exist, each panel is composed from the site's
 * own mini-UI vocabulary (the same rows, chips and paper textures section 2
 * of the home page uses), scaled up to lead. Swapping in a screenshot later
 * means replacing one <Visual> branch, nothing else.
 */
import { ESSENTIALS, TILE_VISUAL } from '../data/product.js';

const { only } = Astro.props;
const sets = only ? ESSENTIALS.filter(s => s.who === only) : ESSENTIALS;
---
{sets.map(set => (
  <section class="tiles-sec" id={`for-${set.who}`}>
    <div class="wrap wrap-read">
      <div class="sechead reveal">
        <h2 class="sechead-h">{set.title}</h2>
        <p class="sechead-sub">{set.lead}</p>
      </div>

      <div class="tiles">
        {set.items.map((it, i) => {
          const kind = TILE_VISUAL[it.label] || 'chat';
          return (
            <article class={`tile reveal ${i === 0 ? 'tile-wide' : ''}`}
                     style={`--tint:var(--${it.tint || 'emerald'})`}>
              <div class={`tile-panel v-${kind}`}>
                {kind === 'sheets' && (
                  /* the sheet is photographed, a scan sweeps it, then each
                     answer is scored in the margin and the total lands */
                  <div class="v-sheet">
                    <div class="v-sheet-paper">
                      <span class="v-scan" aria-hidden="true"></span>
                      {['Q1','Q2','Q3','Q4'].map((q, n) => (
                        <div class="v-ans" style={`--n:${n}`}>
                          <em>{q}</em>
                          <s class="w1"></s><s class="w2"></s><s class="w3"></s>
                          <b class={n === 2 ? 'part' : ''}>{['5/5','4/4','3/5','3/3'][n]}</b>
                        </div>
                      ))}
                    </div>
                    <div class="v-sheet-total"><span>Scored on your rubric</span><b>15/17</b></div>
                  </div>
                )}
                {kind === 'paper' && (
                  <div class="v-paper">
                    <div class="v-paper-head"><b>Unit test &middot; Class VIII</b><span>Ch 4&ndash;5 &middot; 40 marks</span></div>
                    <div class="v-paper-lines"><s></s><s></s><s class="short"></s><s></s><s class="short"></s><s></s></div>
                    <div class="v-paper-tags"><em>Blueprint</em><em>Answer key</em><em>Rubric</em></div>
                  </div>
                )}
                {kind === 'chat' && (
                  <div class="v-chat">
                    <span class="ask">Notes for Ch 4, class VIII</span>
                    <span class="ans">Draft ready &mdash; 6 sections, 2 diagrams</span>
                    <span class="ask">Simpler, for the second section</span>
                    <span class="ans">Rewritten at VII&#8209;B level</span>
                  </div>
                )}
                {kind === 'library' && (
                  <div class="v-lib">
                    <figure><div class="np np-ruled"></div><figcaption>Ch 4 &middot; Light</figcaption></figure>
                    <figure><div class="np np-diagram"></div><figcaption>Ray map</figcaption></figure>
                    <figure><div class="np np-grid"></div><figcaption>Ch 5 &middot; Cells</figcaption></figure>
                    <figure><div class="np np-dots"></div><figcaption>Algebra</figcaption></figure>
                    <figure><div class="np np-ruled np-alt"></div><figcaption>Grammar</figcaption></figure>
                    <figure><div class="np np-grid np-alt"></div><figcaption>Shared</figcaption></figure>
                  </div>
                )}
                {kind === 'notify' && (
                  /* An INBOX, not a lock screen. /pricing already tells
                     schools these arrive by email; a push notification was
                     the wrong medium and contradicted our own page. Three
                     mails land in a parent's inbox, from the school, one
                     after another. */
                  <div class="v-inbox">
                    <div class="v-inbox-head">
                      <span class="v-inbox-to">Inbox &middot; meera.r@gmail.com</span>
                      <span class="v-inbox-count">3 new</span>
                    </div>
                    <ul class="v-mails">
                      {[
                        ['Homework · VII‑B Science', 'Ch 5, Q1–4 — due Thursday. Set by Ms Nair.', '3:40 pm'],
                        ['Attendance · Aarav', 'Marked absent in period 2 today.', '11:05 am'],
                        ['Unit test marks · Science', 'Checked and shared by Ms Nair. 18 / 20.', 'Yesterday'],
                      ].map(([subj, prev, when], n) => (
                        <li class="v-mail" style={`--n:${n}`}>
                          <span class="v-mail-app" aria-hidden="true">
                            <svg viewBox="0 0 20 20" fill="currentColor"><path d="M13.0084 1.3766C13.7737 2.14565 14.2463 3.15379 14.3544 4.22631C15.3798 2.58856 15.6072 1.73351 15.6072 1.73351C16.6106 2.46619 17.2834 3.56947 17.4774 4.80065C17.6467 5.87486 17.4395 6.96965 16.8996 7.90118C18.6871 7.18196 19.3711 6.62453 19.3711 6.62453C19.7544 7.81004 19.6534 9.10001 19.0903 10.2107C18.599 11.1797 17.791 11.943 16.8095 12.3777C18.6762 12.8518 19.5556 12.8049 19.5556 12.8049C19.1723 13.9904 18.3361 14.9743 17.231 15.5402C16.2668 16.034 15.1667 16.1742 14.1183 15.9461C15.3513 17.4323 16.0902 17.9139 16.0902 17.9139C15.0867 18.6465 13.8348 18.9486 12.6097 18.7536C11.5408 18.5835 10.5688 18.0471 9.85413 17.2432C9.98239 19.1739 10.2985 20 10.2985 20C9.0582 20 7.86867 19.5048 6.99163 18.6234C6.2264 17.8544 5.75375 16.8462 5.64567 15.7737C4.62023 17.4115 4.39286 18.2665 4.39286 18.2665C3.38941 17.5338 2.71668 16.4305 2.52265 15.1994C2.35335 14.1252 2.56059 13.0304 3.10043 12.0989C1.31296 12.8181 0.628921 13.3755 0.628921 13.3755C0.245639 12.19 0.346658 10.9 0.909756 9.78937C1.40106 8.82031 2.20902 8.05702 3.19058 7.6223C1.32385 7.14827 0.444435 7.19517 0.444435 7.19517C0.827718 6.00966 1.66391 5.02572 2.76905 4.45982C3.7333 3.96606 4.83338 3.82582 5.88173 4.05395C4.64875 2.56773 3.90986 2.08618 3.90986 2.08618C4.9133 1.3535 6.16527 1.05143 7.39032 1.24643C8.4592 1.41657 9.4312 1.95295 10.1459 2.75678C10.0177 0.826064 9.70151 0 9.70151 0C10.9418 2.42706e-07 12.1314 0.495178 13.0084 1.3766Z"/></svg>
                          </span>
                          <span class="v-mail-body">
                            <span class="v-mail-top"><b>{subj}</b><em>{when}</em></span>
                            <span class="v-mail-prev">{prev}</span>
                          </span>
                        </li>
                      ))}
                    </ul>
                    <span class="v-inbox-foot">Sent by the school &middot; no app to install</span>
                  </div>
                )}
                {kind === 'portal' && (
                  <div class="v-rows">
                    <span><b>&#8594;</b> &ldquo;Create section VI&#8209;C&rdquo;<i>done</i></span>
                    <span><b>&#8594;</b> &ldquo;Move Ramya to VII&#8209;B&rdquo;<i>done</i></span>
                    <span><b>&#8594;</b> &ldquo;Add Physics to class IX&rdquo;<i>done</i></span>
                    <span class="sum"><b>&#8721;</b> No form opened<i>3 asks</i></span>
                  </div>
                )}
                {kind === 'allot' && (
                  /* the empty section is chosen, a list of teachers opens,
                     one is picked, and the row fills */
                  <div class="v-allot">
                    <div class="v-allot-row"><b>IX&#8209;A</b><span>Physics</span><em>R. Nair</em></div>
                    <div class="v-allot-row is-open">
                      <b>VII&#8209;C</b><span>English</span><em class="v-slot">Unassigned</em>
                      <ul class="v-menu">
                        <li>K. Rao</li>
                        <li class="pick">V. Iyer</li>
                        <li>S. Mehta</li>
                      </ul>
                    </div>
                    <div class="v-allot-row"><b>VI&#8209;B</b><span>Maths</span><em>K. Rao</em></div>
                  </div>
                )}
                {kind === 'timetable' && (
                  /* four stages on one clock: the class and section are
                     chosen, the week is configured, Schedule is pressed
                     once, and a teacher's own calendar fills with the
                     periods that belong to them */
                  <div class="v-sched">
                    <div class="v-sched-pick">
                      <span class="vs-field">Class <b>IX</b></span>
                      <span class="vs-field">Section <b>A</b></span>
                      <span class="vs-field vs-term">Term 2</span>
                    </div>

                    <div class="v-tt-grid">
                      <span class="hd"></span>
                      <span class="hd">Mon</span><span class="hd">Tue</span><span class="hd">Wed</span>
                      <span class="hd">Thu</span><span class="hd">Fri</span>
                      {[
                        ['Phy', 'Mat', 'Eng', 'Phy', 'Bio'],
                        ['Mat', 'Eng', 'Phy', 'Che', 'Mat'],
                        ['Eng', 'Bio', 'Mat', 'Eng', 'Phy'],
                        ['Che', 'Phy', 'Bio', 'Mat', 'Eng'],
                      ].map((row, p) => (
                        <>
                          <span class="pd">P{p + 1}</span>
                          {row.map((sub, day) => (
                            <span class={`cell s-${sub.toLowerCase()}`}
                                  style={`--d:${day};--p:${p}`}>{sub}</span>
                          ))}
                        </>
                      ))}
                    </div>

                    <div class="v-sched-act">
                      <span class="vs-btn">Schedule to teachers</span>
                      <span class="vs-done">Scheduled &middot; 32 calendars updated</span>
                    </div>

                    {/* what one teacher opens afterwards */}
                    <div class="v-cal">
                      <span class="v-cal-head"><b>R. Nair</b><em>Thursday</em></span>
                      <span class="v-cal-slot" style="--s:0"><i>P1</i>IX&#8209;A &middot; Physics</span>
                      <span class="v-cal-slot" style="--s:1"><i>P2</i>VIII&#8209;B &middot; Physics</span>
                      <span class="v-cal-slot free" style="--s:2"><i>P3</i>Free</span>
                      <span class="v-cal-slot" style="--s:3"><i>P4</i>IX&#8209;A &middot; Physics</span>
                    </div>
                  </div>
                )}
                {kind === 'year' && (
                  /* the whole school moves up: classes run right to left
                     through a lit centre, edges faded */
                  <div class="v-migrate">
                    <div class="v-mig-window">
                      <div class="v-mig-centre" aria-hidden="true"></div>
                      <div class="v-mig-track">
                      {/* ascending left to right, so the row itself reads
                          as the school climbing, and the class holding the
                          centre goes VI, VII, VIII, IX, X as the loop runs */}
                      {['VI-A','VII-A','VIII-A','IX-A','X-A','VI-A','VII-A','VIII-A','IX-A','X-A'].map(c => (
                        <span class="v-mig-class">{c}</span>
                      ))}
                      </div>
                    </div>
                    <span class="v-mig-note">Every class promoted &middot; library and banks carried forward</span>
                  </div>
                )}
              </div>

              <div class="tile-cap">
                <h3>{it.label}{it.badge && <span class="beat-badge">{it.badge}</span>}</h3>
                <p set:html={it.text} />
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
))}
