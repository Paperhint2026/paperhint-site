---
/* IMAGE-LED TILES — Mercury's feature grid.
 *
 * The important difference from a card: there is no card. The tile IS a large
 * visual panel, and the label and sentence sit UNDERNEATH it, on the page,
 * with no border and no fill. Weighting the visual first is what stops a
 * features section reading as a table of text boxes.
 *
 * The panels alternate dark and light ground tile by tile — the contrast
 * shift the founder asked for, at tile scale rather than section scale.
 *
 * Until real product screens exist, each panel is composed from the site's
 * own mini-UI vocabulary (the same rows, chips and paper textures section 2
 * of the home page uses), scaled up to lead. Swapping in a screenshot later
 * means replacing one <Visual> branch, nothing else.
 */
import { ESSENTIALS, TILE_VISUAL } from '../data/product.js';

const { only } = Astro.props;
const sets = only ? ESSENTIALS.filter(s => s.who === only) : ESSENTIALS;
---
{sets.map(set => (
  <section class="tiles-sec" id={`for-${set.who}`}>
    <div class="wrap wrap-read">
      <div class="sechead reveal">
        <h2 class="sechead-h">{set.title}</h2>
        <p class="sechead-sub">{set.lead}</p>
      </div>

      <div class="tiles">
        {set.items.map((it, i) => {
          const kind = TILE_VISUAL[it.label] || 'chat';
          return (
            <article class={`tile reveal ${i === 0 ? 'tile-wide' : ''}`}
                     style={`--tint:var(--${it.tint || 'emerald'})`}>
              <div class={`tile-panel ${i % 2 ? 'panel-light' : 'panel-dark'} v-${kind}`}>
                {kind === 'sheets' && (
                  /* the sheet is photographed, a scan sweeps it, then each
                     answer is scored in the margin and the total lands */
                  <div class="v-sheet">
                    <div class="v-sheet-paper">
                      <span class="v-scan" aria-hidden="true"></span>
                      {['Q1','Q2','Q3','Q4'].map((q, n) => (
                        <div class="v-ans" style={`--n:${n}`}>
                          <em>{q}</em>
                          <s class="w1"></s><s class="w2"></s><s class="w3"></s>
                          <b class={n === 2 ? 'part' : ''}>{['5/5','4/4','3/5','3/3'][n]}</b>
                        </div>
                      ))}
                    </div>
                    <div class="v-sheet-total"><span>Scored on your rubric</span><b>15/17</b></div>
                  </div>
                )}
                {kind === 'paper' && (
                  <div class="v-paper">
                    <div class="v-paper-head"><b>Unit test &middot; Class VIII</b><span>Ch 4&ndash;5 &middot; 40 marks</span></div>
                    <div class="v-paper-lines"><s></s><s></s><s class="short"></s><s></s><s class="short"></s><s></s></div>
                    <div class="v-paper-tags"><em>Blueprint</em><em>Answer key</em><em>Rubric</em></div>
                  </div>
                )}
                {kind === 'chat' && (
                  <div class="v-chat">
                    <span class="ask">Notes for Ch 4, class VIII</span>
                    <span class="ans">Draft ready &mdash; 6 sections, 2 diagrams</span>
                    <span class="ask">Simpler, for the second section</span>
                    <span class="ans">Rewritten at VII&#8209;B level</span>
                  </div>
                )}
                {kind === 'library' && (
                  <div class="v-lib">
                    <figure><div class="np np-ruled"></div><figcaption>Ch 4 &middot; Light</figcaption></figure>
                    <figure><div class="np np-diagram"></div><figcaption>Ray map</figcaption></figure>
                    <figure><div class="np np-grid"></div><figcaption>Ch 5 &middot; Cells</figcaption></figure>
                    <figure><div class="np np-dots"></div><figcaption>Algebra</figcaption></figure>
                    <figure><div class="np np-ruled np-alt"></div><figcaption>Grammar</figcaption></figure>
                    <figure><div class="np np-grid np-alt"></div><figcaption>Shared</figcaption></figure>
                  </div>
                )}
                {kind === 'notify' && (
                  /* a parent's phone: wallpaper, clock, then the school's
                     message arriving over it */
                  <div class="v-phone">
                    <div class="v-phone-screen">
                      <span class="v-phone-time">3:40</span>
                      <span class="v-phone-date">Thursday 5 September</span>
                      <div class="v-push p1">
                        <i aria-hidden="true"></i>
                        <div><b>Paperhint &middot; Sunrise Public School</b>
                          <span>Homework set for VII&#8209;B &mdash; Science Ch 5, Q1&ndash;4, due Thursday.</span></div>
                      </div>
                      <div class="v-push p2">
                        <i aria-hidden="true"></i>
                        <div><b>Paperhint &middot; Sunrise Public School</b>
                          <span>Aarav was marked absent in period 2 today.</span></div>
                      </div>
                      <div class="v-push p3">
                        <i aria-hidden="true"></i>
                        <div><b>Paperhint &middot; Sunrise Public School</b>
                          <span>Unit test marks are ready &mdash; checked and shared by Ms Nair.</span></div>
                      </div>
                    </div>
                  </div>
                )}
                {kind === 'portal' && (
                  <div class="v-rows">
                    <span><b>&#8594;</b> &ldquo;Create section VI&#8209;C&rdquo;<i>done</i></span>
                    <span><b>&#8594;</b> &ldquo;Move Ramya to VII&#8209;B&rdquo;<i>done</i></span>
                    <span><b>&#8594;</b> &ldquo;Add Physics to class IX&rdquo;<i>done</i></span>
                    <span class="sum"><b>&#8721;</b> No form opened<i>3 asks</i></span>
                  </div>
                )}
                {kind === 'allot' && (
                  /* the empty section is chosen, a list of teachers opens,
                     one is picked, and the row fills */
                  <div class="v-allot">
                    <div class="v-allot-row"><b>IX&#8209;A</b><span>Physics</span><em>R. Nair</em></div>
                    <div class="v-allot-row is-open">
                      <b>VII&#8209;C</b><span>English</span><em class="v-slot">Unassigned</em>
                      <ul class="v-menu">
                        <li>K. Rao</li>
                        <li class="pick">V. Iyer</li>
                        <li>S. Mehta</li>
                      </ul>
                    </div>
                    <div class="v-allot-row"><b>VI&#8209;B</b><span>Maths</span><em>K. Rao</em></div>
                  </div>
                )}
                {kind === 'register' && (
                  /* the full week, period by period, filling as it is scanned */
                  <div class="v-tt">
                    <div class="v-tt-grid">
                      <span class="hd"></span>
                      <span class="hd">Mon</span><span class="hd">Tue</span><span class="hd">Wed</span>
                      <span class="hd">Thu</span><span class="hd">Fri</span>
                      {[1, 2, 3, 4, 5].map(period => (
                        <>
                          <span class="pd">P{period}</span>
                          {[0, 1, 2, 3, 4].map(day => (
                            <span class={`cell ${(period + day) % 7 === 3 ? 'part' : 'full'}`}
                                  style={`--d:${day};--p:${period}`}>
                              {(period + day) % 7 === 3 ? '41' : '44'}
                            </span>
                          ))}
                        </>
                      ))}
                    </div>
                    <span class="v-tt-note">Every period of the week, read from the register</span>
                  </div>
                )}
                {kind === 'year' && (
                  /* the whole school moves up: classes run right to left
                     through a lit centre, edges faded */
                  <div class="v-migrate">
                    <div class="v-mig-track">
                      {['VI-A','VII-A','VIII-A','IX-A','X-A','VI-A','VII-A','VIII-A','IX-A','X-A'].map(c => (
                        <span class="v-mig-class">{c}</span>
                      ))}
                    </div>
                    <div class="v-mig-centre" aria-hidden="true"></div>
                    <span class="v-mig-note">Every class promoted &middot; library and banks carried forward</span>
                  </div>
                )}
              </div>

              <div class="tile-cap">
                <h3>{it.label}{it.badge && <span class="beat-badge">{it.badge}</span>}</h3>
                <p set:html={it.text} />
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
))}
