---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---
<Base
  title="Page not found — Paperhint"
  description="This page skipped class. Head back to Paperhint's home."
  canonical="https://paperhint.com/404"
  noindex
>
<Nav />

<section class="notfound">
  <div class="wrap nf-inner">
    <picture class="nf-kid" aria-hidden="true">
      <source srcset="assets/img/stickers/lost-kid.webp" type="image/webp">
      <img src="assets/img/stickers/lost-kid.png" alt="" width="760" height="1036">
    </picture>
    <div class="nf-copy">
      <div class="nf-code">404</div>
      <h1>This page skipped class</h1>
      <p>The map says it should be here, but it isn't. Let's get you back to somewhere that exists.</p>
      <div class="nf-actions">
        <a class="btn btn-primary btn-lg" href="/">Back to home</a>
        <a class="hero-link" href="/contact">Contact us &rarr;</a>
      </div>
    </div>
  </div>
</section>
</Base>
