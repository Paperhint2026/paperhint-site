---
/* Paperhint enquiry console — internal.
 *
 * Standalone on purpose: no marketing chrome, no chat widget, no NEAT canvas.
 * It's a tool, and it should open instantly on a phone in a corridor.
 *
 * Getting in: type a Paperhint address, a signed link arrives by mail. See
 * api/_auth.js. Nothing here is readable without that grant.
 */
const v = import.meta.env.VERCEL_GIT_COMMIT_SHA?.slice(0, 7) || 'dev';
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Console — Paperhint</title>
<link rel="icon" href="/assets/img/rosette.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..500&family=Merriweather:ital@1&display=swap" rel="stylesheet">
<style is:global>
/* Global on purpose: the console renders its tables, stat cards and detail
   sheet from script at runtime, and Astro's scoped styles only attach to
   elements present in the template. */
:root{
  --ink:#14201A; --ink-soft:#3D4F47; --muted:#68766E;
  --ground:#FAF7F0; --surface:#FFFFFF; --raise:#F6F3EA;
  --line:#E2DED1; --emerald:#0B8A5C; --emerald-soft:#E6F4EE;
  --amber:#B4761A; --amber-soft:#FBF1DE;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --ink:#F2EEE3; --ink-soft:#C6CFC8; --muted:#8A968F;
  --ground:#0A0F0C; --surface:#121A15; --raise:#18211B;
  --line:#26312A; --emerald:#31D492; --emerald-soft:#12261D;
  --amber:#E8B562; --amber-soft:#241C0E;
}}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--ground);color:var(--ink);
  font:400 15px/1.55 Geist,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,sans-serif;
  -webkit-font-smoothing:antialiased}
a{color:var(--emerald)}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}

header.bar{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--ground) 88%,transparent);
  backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.bar-in{display:flex;align-items:center;gap:14px;height:60px}
.mark{font-weight:500;font-size:18px;letter-spacing:-.01em}
.mark i{color:var(--emerald);font-family:Merriweather,Georgia,serif}
.bar-in .sp{flex:1}
.who{font-size:13px;color:var(--muted)}
.btn{font:inherit;font-size:13px;border:1px solid var(--line);background:var(--surface);color:var(--ink-soft);
  padding:7px 14px;border-radius:999px;cursor:pointer}
.btn:hover{border-color:var(--emerald);color:var(--emerald)}
.btn-go{background:var(--emerald);border-color:var(--emerald);color:#fff;font-weight:500;padding:11px 20px;font-size:14px}
.btn-go:hover{color:#fff;filter:brightness(1.06)}

/* the way in */
.gate{min-height:78vh;display:grid;place-items:center;padding:40px 20px}
.gate-card{width:100%;max-width:400px;background:var(--surface);border:1px solid var(--line);
  border-radius:18px;padding:30px}
.gate h1{margin:14px 0 6px;font-size:22px;font-weight:500;letter-spacing:-.02em}
.gate p{margin:0 0 20px;color:var(--muted);font-size:14px}
.gate input{width:100%;font:inherit;padding:12px 14px;border:1px solid var(--line);border-radius:12px;
  background:var(--raise);color:var(--ink);margin-bottom:12px}
.gate input:focus{outline:none;border-color:var(--emerald)}
.said{margin:14px 0 0;font-size:13.5px;line-height:1.5;color:var(--ink-soft)}
.said.bad{color:#B4321A}

/* numbers */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(126px,1fr));gap:10px;margin:24px 0 6px}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 16px}
.stat b{display:block;font-size:26px;font-weight:500;letter-spacing:-.03em;line-height:1.1}
.stat span{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.places{margin:14px 0 0;font-size:13px;color:var(--muted)}
.places b{color:var(--ink-soft);font-weight:500}

h2.sec{margin:30px 0 12px;font-size:15px;font-weight:500;color:var(--muted);
  text-transform:uppercase;letter-spacing:.08em}

/* sessions */
table{width:100%;border-collapse:collapse;background:var(--surface);
  border:1px solid var(--line);border-radius:14px;overflow:hidden}
th{text-align:left;font-size:11.5px;font-weight:500;text-transform:uppercase;letter-spacing:.07em;
  color:var(--muted);padding:11px 14px;border-bottom:1px solid var(--line);background:var(--raise)}
td{padding:12px 14px;border-bottom:1px solid var(--line);font-size:14px;vertical-align:top}
tr:last-child td{border-bottom:0}
tbody tr{cursor:pointer}
tbody tr:hover{background:var(--raise)}
.who-cell b{font-weight:500}
.who-cell small{display:block;color:var(--muted);font-size:12.5px}
.tag{display:inline-block;font-size:11.5px;padding:3px 9px;border-radius:999px;font-weight:500}
.tag.call{background:var(--emerald-soft);color:var(--emerald)}
.tag.ask{background:var(--amber-soft);color:var(--amber)}
.num{font-variant-numeric:tabular-nums;color:var(--ink-soft)}
.ip{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--muted)}
.none{padding:40px 20px;text-align:center;color:var(--muted);background:var(--surface);
  border:1px solid var(--line);border-radius:14px}
.notice{background:var(--amber-soft);color:var(--amber);border:1px solid transparent;
  border-radius:12px;padding:12px 16px;font-size:13.5px;margin:20px 0 0}

/* one visit, in full */
.sheet{position:fixed;inset:0;z-index:20;display:none}
.sheet.on{display:block}
.veil{position:absolute;inset:0;background:rgba(10,15,12,.34);backdrop-filter:blur(2px)}
.panel{position:absolute;top:0;right:0;height:100%;width:min(560px,100%);background:var(--ground);
  border-left:1px solid var(--line);display:flex;flex-direction:column;
  animation:slide .26s cubic-bezier(.2,.7,.2,1)}
@keyframes slide{from{transform:translateX(24px);opacity:.4}to{transform:none;opacity:1}}
.panel-top{display:flex;align-items:flex-start;gap:12px;padding:18px 20px;border-bottom:1px solid var(--line)}
.panel-top h3{margin:0;font-size:17px;font-weight:500;letter-spacing:-.01em}
.panel-top p{margin:3px 0 0;font-size:13px;color:var(--muted)}
.panel-body{overflow:auto;padding:18px 20px 40px;flex:1}
.facts{display:grid;grid-template-columns:104px 1fr;gap:7px 14px;font-size:13.5px;margin:0 0 22px}
.facts dt{color:var(--muted)}
.facts dd{margin:0;color:var(--ink-soft);word-break:break-word}
.turn{margin:0 0 12px;max-width:88%}
.turn.them{margin-left:auto}
.turn .b{padding:10px 13px;border-radius:14px;font-size:14px;line-height:1.5;white-space:pre-wrap}
.turn.them .b{background:var(--emerald-soft);color:var(--ink);border-bottom-right-radius:5px}
.turn.us .b{background:var(--surface);border:1px solid var(--line);border-bottom-left-radius:5px}
.turn .when{font-size:11px;color:var(--muted);margin:4px 4px 0}
.turn.them .when{text-align:right}
.lead{background:var(--surface);border:1px solid var(--emerald);border-radius:14px;padding:14px 16px;margin:0 0 14px}
.lead h4{margin:0 0 8px;font-size:13px;font-weight:500;color:var(--emerald);
  text-transform:uppercase;letter-spacing:.06em}
.foot{padding:26px 0 40px;font-size:12px;color:var(--muted)}
@media (max-width:640px){
  .hide-sm{display:none}
  td,th{padding:10px 11px}
}
</style>
</head>
<body>

<header class="bar"><div class="wrap bar-in">
  <span class="mark">Paper<i>h</i>int</span>
  <span class="who" id="who"></span>
  <span class="sp"></span>
  <button class="btn" id="refresh" hidden>Refresh</button>
  <button class="btn" id="out" hidden>Sign out</button>
</div></header>

<!-- the way in -->
<section class="gate" id="gate" hidden>
  <div class="gate-card">
    <span class="mark">Paper<i>h</i>int</span>
    <h1>Console</h1>
    <p>Enquiries, questions and where they came from. A link arrives by mail.</p>
    <form id="loginForm" novalidate>
      <input id="email" type="email" autocomplete="email" placeholder="you@paperhint.com" required>
      <button class="btn btn-go" type="submit" style="width:100%">Send me the link</button>
    </form>
    <p class="said" id="said" hidden></p>
  </div>
</section>

<!-- the log -->
<main class="wrap" id="main" hidden>
  <div class="stats" id="stats"></div>
  <p class="places" id="places"></p>
  <div id="notice"></div>
  <div id="faultsWrap" hidden>
    <h2 class="sec">Broken things</h2>
    <div id="faults"></div>
  </div>
  <h2 class="sec">Visits</h2>
  <div id="list"></div>
  <p class="foot">Newest first, last 500 events. Addresses are stored as a network, never in full. Build {v}</p>
</main>

<div class="sheet" id="sheet">
  <div class="veil" data-close></div>
  <aside class="panel">
    <div class="panel-top">
      <div style="flex:1">
        <h3 id="sheetName">Visit</h3>
        <p id="sheetWhere"></p>
      </div>
      <button class="btn" data-close>Close</button>
    </div>
    <div class="panel-body" id="sheetBody"></div>
  </aside>
</div>

<script is:inline>
(function () {
  var KEY = 'paperhint.console.k';
  var $ = function (id) { return document.getElementById(id); };

  function grant(v) {
    try { if (v === undefined) return localStorage.getItem(KEY) || '';
          v ? localStorage.setItem(KEY, v) : localStorage.removeItem(KEY); }
    catch (e) { return ''; }
    return v || '';
  }

  /* A grant in the address bar is a grant in someone's history and in every
     screenshot — take it into storage and clean the URL immediately. */
  var q = new URLSearchParams(location.search);
  if (q.get('k')) { grant(q.get('k')); history.replaceState({}, '', location.pathname); }

  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function when(t) {
    var d = new Date(t); if (isNaN(d)) return '—';
    return d.toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
  }
  function ago(t) {
    var m = Math.round((Date.now() - Date.parse(t)) / 6e4);
    if (isNaN(m)) return '';
    if (m < 1) return 'just now';
    if (m < 60) return m + 'm ago';
    if (m < 1440) return Math.round(m / 60) + 'h ago';
    return Math.round(m / 1440) + 'd ago';
  }
  function place(s) {
    return [s.city, s.region, s.country].filter(Boolean).join(', ') || 'somewhere';
  }

  /* ---- the way in ---- */
  function showGate(msg, bad) {
    $('gate').hidden = false; $('main').hidden = true;
    $('out').hidden = true; $('refresh').hidden = true; $('who').textContent = '';
    if (msg) { var p = $('said'); p.hidden = false; p.textContent = msg; p.className = 'said' + (bad ? ' bad' : ''); }
  }

  $('loginForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var email = $('email').value.trim();
    if (!email) return;
    var btn = e.target.querySelector('button');
    btn.disabled = true; btn.textContent = 'Sending…';
    fetch('/api/console-login', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email })
    }).then(function (r) { return r.json().catch(function () { return {}; }); })
      .then(function (j) {
        var p = $('said'); p.hidden = false;
        p.className = 'said' + (j && j.error ? ' bad' : '');
        p.textContent = (j && (j.error || j.sent)) || 'Something went wrong.';
      })
      .catch(function () {
        var p = $('said'); p.hidden = false; p.className = 'said bad';
        p.textContent = 'Could not reach the server.';
      })
      .then(function () { btn.disabled = false; btn.textContent = 'Send me the link'; });
  });

  $('out').addEventListener('click', function () { grant(''); location.reload(); });
  $('refresh').addEventListener('click', function () { load(); });

  /* ---- the log ---- */
  var sessions = [], faults = [];

  function load() {
    var k = grant();
    if (!k) return showGate();
    $('refresh').disabled = true;
    fetch('/api/console', { headers: { Authorization: 'Bearer ' + k } })
      .then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (j) {
          if (r.status === 401) { grant(''); showGate('That link has expired. Ask for a new one.', true); return null; }
          if (!r.ok) { showGate((j && j.error) || 'Could not load the log.', true); return null; }
          return j;
        });
      })
      .then(function (j) { if (j) render(j); })
      .catch(function () { showGate('Could not reach the server.', true); })
      .then(function () { $('refresh').disabled = false; });
  }

  function render(j) {
    $('gate').hidden = true; $('main').hidden = false;
    $('out').hidden = false; $('refresh').hidden = false;
    $('who').textContent = j.who || '';
    sessions = j.sessions || [];
    var s = j.summary || {};

    $('stats').innerHTML = [
      ['Visits', s.sessions], ['Today', s.day], ['This week', s.week],
      ['Questions', s.questions], ['Callbacks', s.callbacks], ['Faults', s.faults]
    ].map(function (p) {
      var bad = p[0] === 'Faults' && p[1];
      return '<div class="stat"><b' + (bad ? ' style="color:#B4321A"' : '') + '>' +
        (p[1] || 0) + '</b><span>' + p[0] + '</span></div>';
    }).join('');

    $('places').innerHTML = (s.places && s.places.length)
      ? 'From ' + s.places.map(function (p) { return '<b>' + esc(p[0]) + '</b> (' + p[1] + ')'; }).join(' · ')
      : '';

    $('notice').innerHTML = j.notice ? '<p class="notice">' + esc(j.notice) + '</p>' : '';

    faults = j.faults || [];
    $('faultsWrap').hidden = !faults.length;
    if (faults.length) {
      $('faults').innerHTML = '<table><thead><tr>' +
        '<th>Fault</th><th class="hide-sm">Where</th><th>Seen</th><th>Last</th>' +
        '</tr></thead><tbody>' + faults.map(function (f, i) {
          return '<tr data-f="' + i + '">' +
            '<td class="who-cell"><b>' + esc(f.message) + '</b>' +
              '<small>' + esc(f.fault) + (f.file ? ' · ' + esc(shortFile(f.file)) +
                (f.line ? ':' + f.line : '') : '') + '</small></td>' +
            '<td class="hide-sm">' + esc((f.pages || []).join(', ') || '—') + '</td>' +
            '<td class="num">' + f.count + '</td>' +
            '<td class="num">' + esc(ago(f.last)) + '</td>' +
          '</tr>';
        }).join('') + '</tbody></table>';
      [].forEach.call($('faults').querySelectorAll('tr[data-f]'), function (tr) {
        tr.addEventListener('click', function () { openFault(faults[+tr.dataset.f]); });
      });
    }

    if (!sessions.length) {
      $('list').innerHTML = '<div class="none">Nothing yet. Every question asked in the panel and every callback lands here.</div>';
      return;
    }

    $('list').innerHTML = '<table><thead><tr>' +
      '<th>Who</th><th>Where</th><th class="hide-sm">Asked</th><th>Last seen</th><th class="hide-sm">Network</th>' +
      '</tr></thead><tbody>' + sessions.map(function (v, i) {
        var name = v.name || (v.email ? v.email : (v.callback ? 'Callback' : 'Anonymous visit'));
        var sub = [v.school, v.role, v.enquiry].filter(Boolean).join(' · ');
        return '<tr data-i="' + i + '">' +
          '<td class="who-cell"><b>' + esc(name) + '</b>' + (sub ? '<small>' + esc(sub) + '</small>' : '') +
            ' ' + (v.callback ? '<span class="tag call">callback</span>' : '<span class="tag ask">asked</span>') + '</td>' +
          '<td>' + esc(place(v)) + '</td>' +
          '<td class="num hide-sm">' + v.questions + '</td>' +
          '<td class="num">' + esc(ago(v.last)) + '</td>' +
          '<td class="ip hide-sm">' + esc(v.ip || '—') + '</td>' +
        '</tr>';
      }).join('') + '</tbody></table>';

    [].forEach.call($('list').querySelectorAll('tr[data-i]'), function (tr) {
      tr.addEventListener('click', function () { open(sessions[+tr.dataset.i]); });
    });
  }

  /* ---- one visit ---- */
  function open(v) {
    if (!v) return;
    $('sheetName').textContent = v.name || v.email || (v.callback ? 'Callback' : 'Anonymous visit');
    $('sheetWhere').textContent = place(v) + ' · ' + when(v.started);

    var out = '';
    if (v.callback) {
      out += '<div class="lead"><h4>Reach them</h4><dl class="facts">' +
        row('Name', v.name) + row('Email', v.email ? '<a href="mailto:' + esc(v.email) + '">' + esc(v.email) + '</a>' : '', true) +
        row('School', v.school) + row('Role', v.role) + row('Enquiry', v.enquiry) +
        '</dl></div>';
    }
    out += '<dl class="facts">' +
      row('Visit', v.anon ? 'grouped by network' : v.id) +
      row('Network', v.ip) + row('Place', place(v)) +
      row('Started', when(v.started)) + row('Last', when(v.last)) +
      row('Pages', (v.pages || []).join(', ')) +
      row('Answered by', (v.models || []).join(', ')) +
      row('Browser', v.ua) +
      '</dl>';

    out += '<h2 class="sec">What was said</h2>';
    (v.events || []).forEach(function (e) {
      if (e.kind === 'question') {
        out += bubble('them', e.text, e.at);
        if (e.reply) out += bubble('us', e.reply, '');
      } else {
        var bits = [e.enquiry ? 'Enquiry: ' + e.enquiry : '', e.via ? 'via ' + e.via : '',
                    (e.reasons && e.reasons.length) ? 'Reasons: ' + [].concat(e.reasons).join(', ') : '',
                    e.text || ''].filter(Boolean).join('\n');
        out += '<div class="lead"><h4>' + esc(e.kind) + ' · ' + esc(when(e.at)) + '</h4>' +
               '<div style="white-space:pre-wrap;font-size:14px;line-height:1.5">' + esc(bits || '—') + '</div>' +
               (e.transcript ? '<details style="margin-top:10px"><summary style="cursor:pointer;font-size:13px;color:var(--muted)">Transcript sent with it</summary>' +
                 '<div style="white-space:pre-wrap;font-size:13px;line-height:1.5;margin-top:8px;color:var(--ink-soft)">' +
                 esc(e.transcript) + '</div></details>' : '') + '</div>';
      }
    });
    if (!(v.events || []).length) out += '<div class="none">No events recorded.</div>';

    $('sheetBody').innerHTML = out;
    $('sheetBody').scrollTop = 0;
    $('sheet').classList.add('on');
  }

  function shortFile(f) { return String(f).replace(/^https?:\/\/[^/]+/, ''); }

  function openFault(f) {
    if (!f) return;
    $('sheetName').textContent = f.message;
    $('sheetWhere').textContent = f.fault + ' · seen ' + f.count +
      (f.count === 1 ? ' time' : ' times');
    var out = '<dl class="facts">' +
      row('Type', f.fault) +
      row('File', f.file ? shortFile(f.file) + (f.line ? ':' + f.line +
        (f.column ? ':' + f.column : '') : '') : '') +
      row('Pages', (f.pages || []).join(', ')) +
      row('Screens', (f.viewports || []).join(', ')) +
      row('Places', (f.places || []).join(' · ')) +
      row('First', when(f.first)) + row('Last', when(f.last)) +
      '</dl>';
    if (f.stack) {
      out += '<h2 class="sec">Stack</h2><pre style="white-space:pre-wrap;font-size:12px;' +
        'line-height:1.5;background:var(--surface);border:1px solid var(--line);' +
        'border-radius:12px;padding:14px;overflow-x:auto;color:var(--ink-soft)">' +
        esc(f.stack) + '</pre>';
    }
    $('sheetBody').innerHTML = out;
    $('sheetBody').scrollTop = 0;
    $('sheet').classList.add('on');
  }

  function row(label, value, raw) {
    if (!value) return '';
    return '<dt>' + label + '</dt><dd>' + (raw ? value : esc(value)) + '</dd>';
  }
  function bubble(side, text, at) {
    return '<div class="turn ' + side + '"><div class="b">' + esc(text) + '</div>' +
           (at ? '<div class="when">' + esc(when(at)) + '</div>' : '') + '</div>';
  }

  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-close]')) $('sheet').classList.remove('on');
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') $('sheet').classList.remove('on');
  });

  load();
})();
</script>
</body>
</html>
