---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Chat from '../components/Chat.astro';
---
<Base
  title="Book a School Software Demo — Paperhint"
  description="Book a demo of Paperhint. Tell us how a week runs in your school today and we will show you the same week running in Paperhint — teachers prepared, the year in one place."
  canonical="https://paperhint.com/contact"
>
<Nav />

<header class="page-hero" style="padding-bottom:0">
  <!-- upper arch: crests beside the banner, flowing the right side downward -->
  <div class="hero-ribbon contact-arch" data-shape="twirl" data-speed="22" data-span="0.62,1.14"
       data-words="*Say* *hello* · book a demo · talk pricing · partnership · support ·"
       style="--band:#7C5CFF;--band-echo:var(--yellow);--band-text:#FAF7F0;--band-kw:#FFD84D"
       aria-hidden="true">
    <svg preserveAspectRatio="none" focusable="false">
      <path class="ribbon-echo"/>
      <path class="ribbon-line"/>
      <path class="bowl-line" id="contact-band-top" fill="none" stroke="none"/>
      <text class="bowl-marquee"><textPath href="#contact-band-top" data-speed="22"></textPath></text>
    </svg>
  </div>

  <svg class="doodle" style="top:308px;right:11.5vw;width:32px;color:var(--yellow)" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C13 7 17 11 24 12C17 13 13 17 12 24C11 17 7 13 0 12C7 11 11 7 12 0Z" fill="currentColor"/></svg>
  <svg class="doodle" style="top:240px;left:5vw;width:150px;color:var(--emerald)" viewBox="0 0 196 36" fill="none" aria-hidden="true"><path d="M8 22Q26 6 44 22T80 22T116 22T152 22T188 22" stroke="currentColor" stroke-width="10" stroke-linecap="round"/></svg>
  <div class="wrap hero-content">
    <span class="tagline"><span class="tag">HELLO</span> We reply within one working day</span>
    <h1 class="display">Tell us about <em>y</em>our school</h1>
  </div>
</header>

<section class="section-pad contact-sec" style="padding-top:30px;padding-bottom:110px">
  <div class="hero-ribbon contact-twirl" data-shape="twirl" data-speed="26" data-span="0.47,1.08"
       data-words="*Say* *hello* · book a demo · talk pricing · partnership · support · a real person replies within *one* *working* *day* ·"
       style="--band:#7C5CFF;--band-echo:var(--yellow);--band-text:#FAF7F0;--band-kw:#FFD84D"
       aria-hidden="true">
    <svg preserveAspectRatio="none" focusable="false">
      <path class="ribbon-echo"/>
      <path class="ribbon-line"/>
      <path class="bowl-line" id="contact-band" fill="none" stroke="none"/>
      <text class="bowl-marquee"><textPath href="#contact-band" data-speed="26"></textPath></text>
    </svg>
  </div>

  <div class="wrap">
    <div class="contact-grid">

      <div class="contact-info reveal">
        <h2 class="title" style="font-size:clamp(26px,3vw,36px)">What happens next</h2>
        <p class="section-sub">No sales sequence. A conversation, then a demo on your own data.</p>

        <div class="c-steps">
          <div class="c-step">
            <span class="c-ico"><img loading="lazy" src="/assets/img/stickers/char-04.png" alt="" width="48" height="48"></span>
            <div>
              <b>You send this form</b>
              <span>Takes about a minute. Nothing gets shared with anyone else.</span>
            </div>
          </div>
          <div class="c-step">
            <span class="c-ico"><img loading="lazy" src="/assets/img/stickers/char-01.png" alt="" width="48" height="48"></span>
            <div>
              <b>We read it properly</b>
              <span>A real person, usually the same day, always within one working day.</span>
            </div>
          </div>
          <div class="c-step">
            <span class="c-ico"><img loading="lazy" src="/assets/img/stickers/char-19.png" alt="" width="48" height="48"></span>
            <div>
              <b>A demo on your own class</b>
              <span>We set up one of your classes beforehand — your syllabus, your paper — so you see your school, not a sample.</span>
            </div>
          </div>
          <div class="c-step">
            <span class="c-ico"><img loading="lazy" src="/assets/img/stickers/char-23.png" alt="" width="48" height="48"></span>
            <div>
              <b>Founding-school terms</b>
              <span>Pricing set together, per student, in writing — with onboarding we do alongside you.</span>
            </div>
          </div>
        </div>

        <div class="c-direct">
          <picture class="mail-mascot" aria-hidden="true">
            <source srcset="/assets/img/stickers/mail-mascot.webp" type="image/webp">
            <img loading="lazy" src="/assets/img/stickers/mail-mascot.png" alt="" width="778" height="967">
          </picture>
          <a href="mailto:support@paperhint.com"><span>✉</span> support@paperhint.com</a>
          <a href="mailto:support@paperhint.com"><span>◷</span> support@paperhint.com</a>
          <a href="/pricing"><span>₹</span> See pricing first</a>
        </div>
      </div>

      <div class="form-card reveal">
        <form class="contact-form" novalidate>
          <div class="etypes">
            <div class="etype">
              <input type="radio" name="etype" id="et-demo" value="demo" checked>
              <label for="et-demo"><span class="eico">▶</span> Book a demo</label>
            </div>
            <div class="etype">
              <input type="radio" name="etype" id="et-pricing" value="pricing">
              <label for="et-pricing"><span class="eico">₹</span> Pricing</label>
            </div>
            <div class="etype">
              <input type="radio" name="etype" id="et-partnership" value="partnership">
              <label for="et-partnership"><span class="eico">◈</span> Partnership</label>
            </div>
            <div class="etype">
              <input type="radio" name="etype" id="et-support" value="support">
              <label for="et-support"><span class="eico">?</span> Support</label>
            </div>
          </div>

          <div class="f-row">
            <div class="field">
              <label for="f-name">Your name</label>
              <input id="f-name" name="name" type="text" autocomplete="name" placeholder="Full name" required>
            </div>
            <div class="field">
              <label for="f-role">Your role</label>
              <select id="f-role" name="role">
                <option>Teacher</option>
                <option>Principal / Head</option>
                <option>Administrator</option>
                <option>Vice Principal</option>
                <option>Trust / District office</option>
                <option>Other</option>
              </select>
            </div>
          </div>

          <div class="f-row">
            <div class="field">
              <label for="f-email">Work email</label>
              <input id="f-email" name="email" type="email" autocomplete="email" placeholder="you@school.edu" required>
            </div>
            <div class="field">
              <label for="f-phone">WhatsApp number <span style="font-weight:400;color:var(--muted)">(optional)</span></label>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="+91">
            </div>
          </div>

          <div class="f-row">
            <div class="field">
              <label for="f-school">School name</label>
              <input id="f-school" name="school" type="text" placeholder="Greenfield Public School" required>
            </div>
            <div class="field">
              <label for="f-size">Students enrolled</label>
              <select id="f-size" name="size">
                <option>Under 500</option>
                <option>500 – 1,000</option>
                <option>1,000 – 2,500</option>
                <option>2,500 +</option>
                <option>Multiple schools</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="f-msg">How does correction work in your school today?</label>
            <div class="chip-row" aria-label="Common reasons — tap to add">
              <button type="button" class="reason-chip">Correction eats our weekends</button>
              <button type="button" class="reason-chip">Question papers take evenings to set</button>
              <button type="button" class="reason-chip">Marks are totalled and copied by hand</button>
              <button type="button" class="reason-chip">Attendance is still a paper register</button>
              <button type="button" class="reason-chip">Notes live in personal folders</button>
            </div>
            <textarea id="f-msg" name="message" placeholder="Red pen and weekends, mark registers copied by hand, a WhatsApp group for homework — however it works today, tell us and we'll show you the same class running in Paperhint."></textarea>
          </div>

          <!-- bot traps: a field people never see, and the time the form rendered -->
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
          <input type="hidden" name="_t" value="">
          <button class="btn btn-primary btn-lg" type="submit" style="width:100%">Send it over</button>
          <p class="form-note">We'll only use this to reply. No lists, no reselling.</p>
        </form>
      </div>

    </div>
  </div>
</section>


<Footer />
<div class="toast" role="status" aria-live="polite"></div>
<Chat />
</Base>
