---
/* The product, in full.
 *
 * Same three moves as the role pages, same measure: banner, a grand intro
 * that says what a school's week actually contains and what Paperhint is
 * inside it, then the work grouped by where it happens — each feature a row
 * with its screenshot beside it. Nothing after that but the ask.
 *
 * Content is src/data/product.js, lifted from docs/feature-list.md.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Chat from '../components/Chat.astro';
import StatRow from '../components/StatRow.astro';
import Tiles from '../components/Tiles.astro';
import ChipDrift from '../components/ChipDrift.astro';
import { PRODUCT as p } from '../data/product.js';

const internal = process.env.VERCEL_ENV !== 'production';
---
<Base title={p.title} description={p.description} canonical="https://paperhint.com/product">
<Nav />

<header class="role-hero">
  <div class="wrap wrap-read">
    <span class="tagline"><span class="tag">{p.kicker}</span> Paperhint <i>·</i></span>
    <h1 class="display role-h1">{p.h1[0]}<em>{p.h1[1]}</em>{p.h1[2]}</h1>
    <p class="role-sub">{p.sub}</p>
    <div class="role-cta">
      <a class="btn btn-primary btn-lg" href="/contact?type=demo">Book a demo</a>
      <a class="btn btn-ghost btn-lg" href="/teachers">Start with a teacher’s week</a>
    </div>
    {internal && (
      <div class="role-needs">
        <b>Waiting on content</b>
        <ul>{p.needs.map(n => <li>{n}</li>)}</ul>
      </div>
    )}
  </div>
</header>

<!-- the grand intro: the week, then what Paperhint is inside it -->
<StatRow />

<section class="role-intro">
  <div class="wrap wrap-read">
    <p class="intro-statement reveal" set:html={p.opening} />
    <p class="intro-turn reveal">{p.introTurn}</p>
    <p class="intro-answer reveal" set:html={p.introAnswer} />
  </div>
</section>

<!-- the old world, on a ground that changes under the reader -->
<ChipDrift who="teachers" />

<!-- the ten essentials: five a teacher wants, five a school wants -->
<Tiles />

<section class="cta role-cta-band">
  <div class="wrap wrap-read">
    <div data-component="cta-banner" data-heading={p.cta.heading} data-sub={p.cta.sub}></div>
  </div>
</section>

<Footer />
<Chat />
</Base>
